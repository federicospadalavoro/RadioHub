# Copiare in .env nella cartella principale. Non inserire segreti nei file VITE_*.
# Server locale e frontend. API_PROXY_TARGET vuoto usa PORT sullo stesso Mac.
HOST=0.0.0.0
PORT=3000
FRONTEND_PORT=5173
API_PROXY_TARGET=
NODE_IMAGE=node:24-bookworm-slim
NGINX_IMAGE=nginx:stable-alpine

# Porte del Mac; nei container PostgreSQL e Redis usano 5432 e 6379.
# Le credenziali qui sono solo per lo sviluppo locale.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=radiohub
POSTGRES_PASSWORD=radiohub
POSTGRES_DB=radiohub
POSTGRES_IMAGE=postgres:17-alpine
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_IMAGE=redis:7-alpine
# Opzionali: URL completi per servizi esterni. Se valorizzati prevalgono sui campi sopra.
DATABASE_URL=
REDIS_URL=
HEALTHCHECK_INTERVAL_SECONDS=5
HEALTHCHECK_TIMEOUT_SECONDS=3
HEALTHCHECK_RETRIES=10
SERVICE_TIMEOUT_MS=3000
# trace, debug, info, warn, error, fatal oppure silent.
LOG_LEVEL=info

# Scadenza della cache in secondi; frequenza del job in millisecondi.
CACHE_TTL_SECONDS=300
NEWS_SYNC_INTERVAL_MS=300000
NEWS_FEED_URL=https://d3r6kmd22dkoyn.cloudfront.net/
FM_WORLD_URL=https://connect.fm-world.com/client2/radios
FM_WORLD_TOKEN=
UPSTREAM_TIMEOUT_MS=10000

# AI: mock funziona senza chiave; openai usa AI_API_KEY.
LLM_PROVIDER=mock
AI_API_KEY=
AI_MODEL=gpt-6-luna
AI_REASONING_EFFORT=low
AI_TIMEOUT_MS=30000
AI_SEARCH_TIMEOUT_MS=15000
AI_SUMMARY_MAX_TOKENS=1000
AI_ANSWER_MAX_TOKENS=500
AI_MAX_TITLE_CHARS=500
AI_MAX_CONTENT_CHARS=12000
AI_SOURCE_MAX_CHARS=3000

# Autenticazione e limiti. NODE_ENV=production va impostato nel server/container.
JWT_SECRET=replace-with-a-long-random-secret
ACCESS_TOKEN_SECONDS=900
REFRESH_TOKEN_DAYS=7
# Vuoto: Secure in produzione. Compose locale usa false; con HTTPS impostare true.
COOKIE_SECURE=
PASSWORD_HASH_ROUNDS=12
# CORS_ORIGINS opzionale: senza valore esplicito segue FRONTEND_PORT in locale.
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
API_RATE_LIMIT=300
AUTH_RATE_LIMIT=10
AI_RATE_LIMIT=10
RATE_LIMIT_WINDOW_MS=900000
AI_RATE_LIMIT_WINDOW_MS=60000
# Dietro un proxy fidato, impostare TRUST_PROXY=1 (o il numero effettivo di proxy).
SSE_MAX_CLIENTS=100
SSE_HEARTBEAT_MS=25000
SSE_RETRY_MS=3000
